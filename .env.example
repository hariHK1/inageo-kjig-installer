# Baris yang diakhiri "# @wajib" atau "# @opsional" dibaca LANGSUNG oleh
# install.sh (validate_existing_env, lihat komentar di sana) untuk mendeteksi
# variabel mana yang wajib/opsional — bukan sekadar dokumentasi. Menambah var
# wajib/opsional baru (mis. saat menambah service baru) CUKUP menandai baris
# di sini, install.sh otomatis ikut, tidak perlu edit array terpisah lagi.
# Var lain (tanpa marker ini) tidak divalidasi keberadaannya sama sekali —
# aman dibiarkan kosong/default selamanya.

# === Registry (GHCR) — image dibangun & di-tag oleh GitHub Actions di repo
# source (inageo-mapviewer), repo ini cuma pull ===
# Versi image yang mau di-deploy, HARUS sama persis dengan tag release yang
# sudah dibuat GitHub Actions (mis. v0.1.0) — atau `latest` untuk selalu ambil
# rilis terbaru (tidak reproducible, tidak disarankan produksi). WAJIB diisi
# apa pun mode instalasinya (pull GHCR ATAU load dari bundle tar.gz).
RELEASE_VERSION= # @wajib
# GHCR_OWNER/GHCR_REPO WAJIB diisi di KEDUA mode (pull ATAU bundle) — dipakai
# docker-compose.yml membentuk nama image (ghcr.io/$GHCR_OWNER/$GHCR_REPO-app:...).
# HARUS SAMA PERSIS dengan owner & nama repo GitHub source (inageo-mapviewer
# BUKAN nama image yang benar — cek nama repo sebenarnya lewat `git remote -v`
# di repo source, mis. kalau repo-nya "inageo-kjig" ya isi GHCR_REPO=inageo-kjig).
# Salah isi ini = docker compose tidak akan pernah menemukan image yang benar,
# baik lewat pull maupun setelah load bundle.
GHCR_OWNER= # @wajib
GHCR_REPO= # @wajib
# PULL_MODE=true  → server ini pull image langsung dari ghcr.io (menu
#                    "Pull"/"Deploy" di deploy.sh). Kredensial (username +
#                    PAT scope read:packages) DITANYAKAN INTERAKTIF setiap
#                    kali deploy.sh butuh docker login — SENGAJA tidak
#                    disimpan di file ini sama sekali, supaya dev lain yang
#                    punya akses baca server (mis. lewat SSH/shared account)
#                    tidak bisa melihat token di .env. Input token disembunyikan
#                    (tidak muncul di terminal) dan tidak pernah ditulis ke disk.
# PULL_MODE=false → server TIDAK punya akses internet ke ghcr.io (mis.
#                    jaringan internal tertutup) — pakai menu "Load image dari
#                    bundle" (tar.gz dari GitHub Release, didownload manual di
#                    mesin lain lalu ditransfer ke server ini), tidak pernah
#                    butuh docker login. Lihat README.md.
PULL_MODE=true

# === Konfigurasi backend geoportal (server-side only) ===
# Token bersama app<->harvester (proxy internal, header x-access-token) —
# WAJIB diisi, kalau kosong semua endpoint harvester menolak (gagal-tertutup).
API_ACCESS_TOKEN= # @wajib
# Alamat harvester yang dipakai app. Kosongkan = pakai service `harvester`
# di stack ini (default http://harvester:4000).
#
# Diisi HANYA kalau harvester dikelola pihak lain — mis. stack compose
# terpisah di server yang sama, atau host lain. Dipakai bersama menu 20
# ("Deploy APP SAJA") di deploy.sh.
#   http://harvester-mitra:4000      -> container di server yang sama; container
#                                       itu WAJIB ikut bergabung ke network stack
#                                       ini agar bisa dipanggil lewat nama service
#   https://harvester.instansi.go.id -> host lain
#
# API_ACCESS_TOKEN di atas WAJIB sama dengan milik harvester tujuan —
# harvester menolak semua permintaan yang tokennya tidak cocok.
API_BACKEND=
# true = harvester dikelola pihak lain. Diisi OTOMATIS oleh deploy.sh
# (menu 20 -> true, menu 2 -> false), jarang perlu diubah manual.
# Efeknya: halaman admin Kesehatan Sistem & Skema Infrastruktur memberi
# keterangan bahwa isinya bersumber dari harvester tersebut.
HARVESTER_EXTERNAL=false
# Guard proxy /apis/[...path] (POST/DELETE) — endpoint itu tidak dipakai UI
# aplikasi ini sendiri, kosong (default) = method itu selalu ditolak.
ADMIN_API_TOKEN= # @opsional
# Cookie sesi dashboard admin (/admin/**, login lewat /apis/admin/login) —
# WAJIB diisi (install.sh generate otomatis), container app tidak akan start
# tanpa ini. Generate manual: openssl rand -base64 32
DASHBOARD_SESSION_SECRET= # @wajib
# reCAPTCHA v2 di form login /admin/login — OPSIONAL, dua-duanya kosong =
# login tanpa CAPTCHA. Daftar di google.com/recaptcha/admin (reCAPTCHA v2
# "Checkbox", domain harus sama persis dengan DOMAIN di bawah).
RECAPTCHA_SITE_KEY= # @opsional

# Kunci API CartoDB untuk basemap Carto (Positron/Dark Matter/Voyager) di Map
# Viewer. Carto mewajibkan kunci, dengan kuota 5.000.000 permintaan ubin per
# bulan kalender dihitung lintas layanan.
#
# BUKAN rahasia: kunci ini dipasang pada URL ubin yang diminta LANGSUNG oleh
# peramban, jadi memang terlihat di sana (kunci publishable, sama sifatnya
# dengan RECAPTCHA_SITE_KEY di atas). Yang perlu dijaga kuotanya, bukan
# kerahasiaannya.
#
# Boleh dikosongkan — basemap Carto sekadar tidak tampil, dan basemap BAWAAN
# (Topografi/ArcGIS) tidak terpengaruh sama sekali. Nilai di sini bisa ditimpa
# sewaktu-waktu lewat halaman admin Manajemen Peta, tanpa menyunting berkas ini
# dan tanpa membuat ulang container — dipakai kalau kuota habis atau kunci
# perlu dirotasi mendadak.
CARTO_API_KEY= # @opsional
RECAPTCHA_SECRET_KEY= # @opsional

# Terjemahan otomatis ID->EN di CMS beranda (halaman admin "Manajemen
# Beranda") — OPSIONAL. Kosong = tombol "Terjemahkan ke English"
# disembunyikan; admin mengetik terjemahan manual, sisa CMS tetap berfungsi
# penuh. Key gratis (500.000 karakter/bulan) di deepl.com/pro-api — key tier
# gratis berakhiran ":fx", endpoint dipilih otomatis dari situ.
# PERHATIAN: mengaktifkan berarti teks yang diterjemahkan dikirim ke server
# DeepL (pihak ketiga, luar negeri) — pertimbangkan kebijakan instansi.
DEEPL_API_KEY= # @opsional

# Akun login dashboard admin pertama TIDAK dibuat lewat wizard ini — setelah
# deploy, jalankan sekali:
#   docker compose run --rm -e INITIAL_ADMIN_USERNAME=<user> -e INITIAL_ADMIN_PASSWORD=<pass> harvester node dist/scripts/seed-admin-user.js

# === Config publik app — SEPENUHNYA runtime (src/lib/runtimeConfig.ts di
# repo source), TIDAK di-bake saat build. Ganti nilai di sini + jalankan
# `docker compose up -d app` (TANPA pull/rilis baru) cukup, image yang sama
# langsung pakai nilai baru. ===
# Origin aplikasi ini — dipakai cek CORS ke server WMS (server-side) DAN
# dibaca browser (basemap/link). WAJIB cocok dengan DOMAIN+protokol di bawah.
APP_ORIGIN=
# 'sample' = baca public/sample-csw.json bawaan image; 'backend' = pakai
# backend harvester (service postgres/redis-queue/harvester di bawah).
DATA_SOURCE=backend
# 'development' mengaktifkan devLog di console browser; selain itu mati.
REACT_APP=production
# Basemap kustom (opsional) — kosong = pakai default publik (RBI BIG, ArcGIS Online).
RBI_URL=
GRAY_URL=
GRAY_URL_ATTR=
SATELLITE_URL=
SATELLITE_URL_ATTR=
TOPO_URL=
TOPO_URL_ATTR=

# === Object storage (MinIO) ===
# DUA pemakai: (1) cache thumbnail katalog — thumbnail dirender SEKALI lalu
# disimpan permanen; tanpa ini layer berat (mis. batas desa se-Indonesia)
# dirender ulang di server instansi tiap kali cache 1 jam habis, untuk tiap
# pengunjung baru. (2) preview dokumen harvest.
# Kosongkan MINIO_ENDPOINT = kedua fitur no-op (thumbnail TETAP tampil, cuma
# selalu dirender live & tidak pernah tersimpan — cache tidak pernah jadi
# jalur gagal).
# Default menunjuk ke service `minio` di docker-compose.yml stack ini:
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
# Kredensial root service minio. MINIO_ACCESS_KEY/SECRET_KEY yang dipakai app
# harus SAMA dgn dua nilai ini kalau memakai minio bawaan stack. Diisi
# otomatis oleh install.sh (instalasi baru) atau deploy.sh
# (ensure_minio_credentials, untuk instalasi lama yang .env-nya belum punya).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Bucket cache thumbnail + umur maksimalnya. Umur ini jaring pengaman untuk
# kasus yang TIDAK tertangkap kunci-konten: instansi mengubah isi peta tanpa
# menyentuh metadata/bbox. Dipasang sebagai lifecycle rule oleh service
# `minio-init`, bukan job cleanup di kode.
THUMBNAIL_BUCKET=catalog-thumbnails
THUMBNAIL_TTL_DAYS=30
# Daftar bucket yang boleh diakses /apis/file, dipisah koma. JANGAN masukkan
# THUMBNAIL_BUCKET ke sini — endpoint itu menerima key dari klien, sedangkan
# bucket thumbnail dilayani endpoint sendiri yang tidak pernah begitu.
ALLOWED_BUCKETS=

# === GeoServer + PostGIS — FITUR OPSIONAL ===
# Menyajikan batas wilayah Provinsi/Kabupaten/Kota untuk section "Peta Simpul
# Jaringan" di /beranda. HANYA geometri batas wilayah POLOS — status koneksi
# simpul TIDAK PERNAH disimpan di sini, digabung live di browser (lihat
# docker-compose.yml, service geoserver-db/geoserver).
#
# BIARKAN KOSONG KALAU TIDAK DIPAKAI (default). Efeknya:
#   - service geoserver & geoserver-db tidak pernah dijalankan (hemat ~3
#     core / 3GB RAM)
#   - section "Peta Simpul Jaringan" di /beranda otomatis SEMBUNYI (bukan
#     tampil sebagai peta rusak)
#   - menu "Manajemen Peta" di dashboard admin ikut disembunyikan
#   - sisa aplikasi (katalog, map viewer, dashboard admin) jalan normal penuh
#
# UNTUK MENGAKTIFKAN, isi DUA-DUANYA (saling melengkapi, wajib keduanya):
#   1) COMPOSE_PROFILES=geoserver        <- menyalakan container-nya
#   2) GEOSERVER_URL=http://geoserver:8080/geoserver   <- memberi tahu app
# lalu isi password di bawah, dan unggah SHP batas wilayah lewat halaman
# admin "Manajemen Peta".
COMPOSE_PROFILES=
GEOSERVER_URL=
# WAJIB diisi kalau profil geoserver aktif (kosong = admin console GeoServer
# tanpa password). Generate: openssl rand -base64 24
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=
GEOSERVER_DB_USER=geoserver
GEOSERVER_DB_PASSWORD=
GEOSERVER_DB_NAME=geoserver

# === Docker Compose / nginx (+ certbot kalau tidak di belakang WAF) ===
DOMAIN= # @wajib
BEHIND_WAF=false
WAF_TRUSTED_CIDR=
TLS_MODE=letsencrypt
ACME_EMAIL=
APP_REPLICAS=2

# === Batas resource per container (opsional — default di bawah SUDAH
# dipakai otomatis oleh docker-compose.yml walau baris ini dibiarkan kosong,
# lihat sintaks ${VAR:-default} di sana). Sinkron dgn repo source
# (inageo-mapviewer docker-compose.yml) — sesuaikan HANYA berdasar `docker
# stats` nyata di server produksi, bukan tebakan. Batas app/harvester berlaku
# PER REPLIKA (lihat APP_REPLICAS di atas / HARVESTER_REPLICAS di bawah). ===
APP_CPU_LIMIT=2
APP_MEMORY_LIMIT=2G
APP_CPU_RESERVATION=0.5
APP_MEMORY_RESERVATION=512M
HARVESTER_CPU_LIMIT=1
HARVESTER_MEMORY_LIMIT=1G
# Server dedicated (lihat catatan ES_JAVA_OPTS di bawah) — default di sini
# jauh lebih longgar drpd service lain krn tidak berbagi host, sesuaikan naik
# kalau server yang disiapkan lebih besar dari asumsi 64GB/32-core.
ELASTICSEARCH_CPU_LIMIT=16
ELASTICSEARCH_MEMORY_LIMIT=32G

# === Port (bisa diganti semua lewat sini, tidak perlu edit docker-compose.yml) ===
# Port publik nginx — ganti kalau 80/443 sudah dipakai service lain di server ini.
HTTP_PORT=80
HTTPS_PORT=443
#
# Expose langsung ke host (opsional, TIDAK disarankan produksi — tiap baris
# di bawah kosong = TIDAK ter-expose sama sekali, postur default tetap aman).
# Untuk mengaktifkan salah satu/semua, isi port yang diinginkan DAN aktifkan
# baris COMPOSE_FILE di bawah (install.sh melakukan ini otomatis kalau kamu
# jawab "ya" saat wizard ditanya).
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
REDIS_QUEUE_HOST_PORT=
HARVESTER_HOST_PORT=
MAPPROXY_HOST_PORT=
ELASTICSEARCH_HOST_PORT=
# APP_DIRECT_PORT beda dari 5 port di atas — HANYA bisa dipakai kalau
# APP_REPLICAS=1 (2+ replica tidak bisa berbagi 1 port host). Overlay-nya pun
# terpisah (docker-compose.app-port.yml, BUKAN docker-compose.ports.yml) —
# WAJIB ikut ditambahkan ke COMPOSE_FILE di bawah kalau kamu isi ini manual,
# supaya tidak mengulang bug lama (port app ikut ter-publish ke default 3000
# walau var ini kosong).
APP_DIRECT_PORT=
# Kosong = docker-compose.ports.yml TIDAK ikut dipakai (5 port infra di atas
# diabaikan apa pun isinya). Isi persis seperti ini untuk mengaktifkan:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yml
# Kalau APP_DIRECT_PORT JUGA diisi, tambahkan overlay ketiga di ujungnya:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yml:docker-compose.app-port.yml
COMPOSE_FILE=

# === DNS (opsional) — lihat docker-compose.dns.yml untuk latar belakang
# lengkap. Isi HANYA kalau container app/harvester pernah gagal resolusi DNS
# intermiten (log 'EAI_AGAIN') padahal server ini sendiri terhubung internet
# normal — itu biasanya bug jalur relay DNS bawaan Docker (127.0.0.11 -> stub
# systemd-resolved), bukan DNS server jaringan kamu yang rusak. Kosong = jalur
# default Docker tetap dipakai, tidak ada perubahan perilaku.
DNS_PRIMARY=
DNS_FALLBACK=1.1.1.1
# WAJIB tambahkan overlay ini ke COMPOSE_FILE di atas kalau DNS_PRIMARY diisi
# manual (install.sh melakukan ini otomatis lewat wizard):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.dns.yml

# === Database & antrian job harvester (PostGIS + Redis khusus queue) ===
# State PERSISTEN pertama di stack ini (beda dari Redis cache tile yang boleh
# hilang) — dicadangkan otomatis harian (service postgres-backup, pg_dump
# format custom + retensi), lihat POSTGRES_BACKUP_* di bawah. (Sebelumnya
# "di luar cakupan installer ini" — sekarang sudah diporting dari repo source.)
POSTGRES_USER=harvester
POSTGRES_PASSWORD= # @wajib
POSTGRES_DB=harvester
REDIS_QUEUE_PASSWORD= # @wajib
REDIS_QUEUE_MAXMEMORY=256mb
HARVEST_SCAN_INTERVAL_MS=3600000
# Backup otomatis Postgres (service postgres-backup) — interval detik
# (default 86400 = 24 jam), retensi hari (default 14). Restore manual: lihat
# catatan di docker-compose.yml service postgres-backup.
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=14
# Jumlah replika proses harvester — worker BullMQ & scheduler sudah didesain
# aman multi-replica (lock Redis per-simpul, dedup jobId). Batas resource di
# atas (HARVESTER_CPU_LIMIT/HARVESTER_MEMORY_LIMIT) berlaku PER REPLIKA —
# kalikan sendiri sebelum menaikkan jauh, cek total budget di docker-compose.yml.
HARVESTER_REPLICAS=1
# Batas jumlah fitur yang ditarik PER LAYER saat indexing isi-data (fitur
# "Cari Data" isi-data, bukan cuma metadata katalog) — jaring pengaman ukuran
# index Elasticsearch, bukan target normal (layer biasa jauh di bawah ini).
MAX_FEATURES_PER_LAYER=50000

# === Elasticsearch (fitur "Cari Data" — katalog + isi-data) ===
# Butuh server dengan RAM cukup besar (lihat ES_JAVA_OPTS di docker-compose.yml,
# heap default 16GB) — state PERSISTEN, sama seperti Postgres, siapkan backup
# terpisah (snapshot ES) di luar cakupan installer ini.
ELASTIC_PASSWORD= # @wajib

# === Cache tile (Redis, disposable, murni cache) ===
REDIS_MAXMEMORY=512mb
REDIS_PASSWORD= # @wajib

# === Fase 0 observability — GlitchTip (error-tracking, kompatibel SDK
# Sentry) + Uptime Kuma (uptime monitoring), self-hosted. Lihat service
# glitchtip*/uptime-kuma di docker-compose.yml. Dashboard NATIVE KEDUANYA
# TIDAK diekspos publik sama sekali (tidak ada port terpisah) — ringkasannya
# tampil di /admin/kesehatan-sistem (dashboard admin app, khusus role
# Superadmin), harvester membacanya lewat API internal masing-masing. ===

# DSN dikirim SDK Sentry (app & harvester, server-side saja) ke GlitchTip —
# KOSONG = error-tracking mati total (SDK no-op), aplikasi tetap jalan
# normal. Didapat dari dashboard GlitchTip setelah bikin akun+project di
# sana lewat UI-nya (buka via SSH port-forward/`docker compose exec` sekali
# di awal, lihat README.md), BUKAN dibuat otomatis compose ini.
SENTRY_DSN=
# DSN terpisah utk harvester (project GlitchTip beda, opsional) — isi nilai
# yang sama dengan SENTRY_DSN di atas kalau tidak perlu dipisah triase-nya.
HARVESTER_SENTRY_DSN=

# Kredensial Postgres/Valkey KHUSUS GlitchTip — TERPISAH dari
# POSTGRES_PASSWORD/REDIS_QUEUE_PASSWORD (punya harvester), isolasi blast
# radius. install.sh generate otomatis kalau kosong (sama pola dgn
# POSTGRES_PASSWORD dkk).
GLITCHTIP_DB_PASSWORD= # @wajib
GLITCHTIP_VALKEY_PASSWORD= # @wajib
# Secret key internal Django GlitchTip (BUKAN password login).
GLITCHTIP_SECRET_KEY= # @wajib
# Opsional — kosong = email cuma ditulis ke log container (consolemail://),
# tidak benar-benar terkirim, dashboard tetap berfungsi penuh tanpa SMTP.
# Isi kalau perlu notifikasi email (undangan anggota, reset password), mis.
# smtp://user:password@smtp.example.go.id:587
GLITCHTIP_EMAIL_URL=
GLITCHTIP_FROM_EMAIL=

# Dibaca harvester utk widget ringkasan GlitchTip di /admin/kesehatan-sistem
# (REST API GlitchTip, BUKAN dashboard native). Diisi MANUAL pasca-deploy —
# token baru ADA setelah GlitchTip pertama kali dikonfigurasi lewat UI-nya
# sendiri (Profile -> Auth Tokens, scope read-only cukup) & bikin
# organisasi. Kosong = widget tampil "belum dikonfigurasi", bukan error.
GLITCHTIP_API_TOKEN=
GLITCHTIP_ORG_SLUG=

# Dibaca harvester utk widget ringkasan Uptime Kuma di /admin/kesehatan-sistem
# (endpoint /metrics Prometheus Kuma, satu-satunya API resmi yang stabil).
# Diisi MANUAL pasca-deploy — API Key baru ADA setelah dibuat lewat UI Kuma
# (Settings -> API Keys). Username boleh apa saja (Kuma pakai API Key sbg
# password Basic Auth). Kosong = widget tampil "belum dikonfigurasi".
UPTIME_KUMA_METRICS_USERNAME=
UPTIME_KUMA_METRICS_PASSWORD=
