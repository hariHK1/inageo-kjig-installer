# === Registry (GHCR) — image dibangun & di-tag oleh GitHub Actions di repo
# source (inageo-mapviewer), repo ini cuma pull ===
# Versi image yang mau di-deploy, HARUS sama persis dengan tag release yang
# sudah dibuat GitHub Actions (mis. v0.1.0) — atau `latest` untuk selalu ambil
# rilis terbaru (tidak reproducible, tidak disarankan produksi). WAJIB diisi
# apa pun mode instalasinya (pull GHCR ATAU load dari bundle tar.gz).
RELEASE_VERSION=
# GHCR_OWNER/GHCR_REPO WAJIB diisi di KEDUA mode (pull ATAU bundle) — dipakai
# docker-compose.yml membentuk nama image (ghcr.io/$GHCR_OWNER/$GHCR_REPO-app:...).
# HARUS SAMA PERSIS dengan owner & nama repo GitHub source (inageo-mapviewer
# BUKAN nama image yang benar — cek nama repo sebenarnya lewat `git remote -v`
# di repo source, mis. kalau repo-nya "inageo-kjig" ya isi GHCR_REPO=inageo-kjig).
# Salah isi ini = docker compose tidak akan pernah menemukan image yang benar,
# baik lewat pull maupun setelah load bundle.
GHCR_OWNER=
GHCR_REPO=
# GHCR_USERNAME/GHCR_TOKEN HANYA dibutuhkan kalau server ini pull langsung
# dari ghcr.io (menu "Pull"/"Deploy" di deploy.sh). Kalau server TIDAK punya
# akses internet ke ghcr.io (mis. jaringan internal tertutup), boleh
# dikosongkan — pakai menu "Load image dari bundle" (tar.gz dari GitHub
# Release, didownload manual di mesin lain lalu ditransfer ke server ini)
# sebagai gantinya. Lihat README.md.
#
# Kredensial pull image PRIVATE — buat Personal Access Token BARU khusus ini
# (GitHub → Settings → Developer settings → Personal access tokens → Fine-grained,
# scope minimal: read:packages). JANGAN pakai token yang sudah pernah
# ter-expose di tempat lain (chat, commit, dsb) — anggap token begitu selalu
# sudah bocor, buat baru.
GHCR_USERNAME=
GHCR_TOKEN=

# === Konfigurasi backend geoportal (server-side only) ===
# Token bersama app<->harvester (proxy internal, header x-access-token) —
# WAJIB diisi, kalau kosong semua endpoint harvester menolak (gagal-tertutup).
API_ACCESS_TOKEN=

# === Config publik app — SEPENUHNYA runtime (src/lib/runtimeConfig.ts di
# repo source), TIDAK di-bake saat build. Ganti nilai di sini + jalankan
# `docker compose up -d app` (TANPA pull/rilis baru) cukup, image yang sama
# langsung pakai nilai baru. ===
# Origin aplikasi ini — dipakai cek CORS ke server WMS (server-side) DAN
# dibaca browser (basemap/link). WAJIB cocok dengan DOMAIN+protokol di bawah.
APP_ORIGIN=
# 'sample' = baca public/sample-csw.json bawaan image; 'backend' = pakai
# backend harvester (service postgres/redis-queue/harvester di bawah).
DATA_SOURCE=backend
# 'development' mengaktifkan devLog di console browser; selain itu mati.
REACT_APP=production
# Basemap kustom (opsional) — kosong = pakai default publik (RBI BIG, ArcGIS Online).
RBI_URL=
GRAY_URL=
GRAY_URL_ATTR=
SATELLITE_URL=
SATELLITE_URL_ATTR=
TOPO_URL=
TOPO_URL_ATTR=

# === Object storage untuk preview dokumen harvest (opsional) ===
MINIO_ENDPOINT=
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
ALLOWED_BUCKETS=

# === Docker Compose / nginx (+ certbot kalau tidak di belakang WAF) ===
DOMAIN=
BEHIND_WAF=false
WAF_TRUSTED_CIDR=
TLS_MODE=letsencrypt
ACME_EMAIL=
APP_REPLICAS=2

# === Port (bisa diganti semua lewat sini, tidak perlu edit docker-compose.yml) ===
# Port publik nginx — ganti kalau 80/443 sudah dipakai service lain di server ini.
HTTP_PORT=80
HTTPS_PORT=443
#
# Expose langsung ke host (opsional, TIDAK disarankan produksi — tiap baris
# di bawah kosong = TIDAK ter-expose sama sekali, postur default tetap aman).
# Untuk mengaktifkan salah satu/semua, isi port yang diinginkan DAN aktifkan
# baris COMPOSE_FILE di bawah (install.sh melakukan ini otomatis kalau kamu
# jawab "ya" saat wizard ditanya).
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
REDIS_QUEUE_HOST_PORT=
HARVESTER_HOST_PORT=
MAPPROXY_HOST_PORT=
APP_DIRECT_PORT=
# Kosong = docker-compose.ports.yml TIDAK ikut dipakai (semua port di atas
# diabaikan apa pun isinya). Isi persis seperti ini untuk mengaktifkan:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yml
COMPOSE_FILE=

# === Database & antrian job harvester (PostGIS + Redis khusus queue) ===
# State PERSISTEN pertama di stack ini (beda dari Redis cache tile yang boleh
# hilang) — siapkan backup (pg_dump terjadwal) terpisah, di luar cakupan
# installer ini.
POSTGRES_USER=harvester
POSTGRES_PASSWORD=
POSTGRES_DB=harvester
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_MAXMEMORY=256mb
HARVEST_SCAN_INTERVAL_MS=3600000

# === Cache tile (Redis, disposable, murni cache) ===
REDIS_MAXMEMORY=512mb
REDIS_PASSWORD=
