# Template — deploy.sh menyalin file ini menjadi default.conf (gitignored) dan
# mengganti __DOMAIN__ sekali via sed saat pertama kali dijalankan. Setelah itu
# default.conf bebas diedit manual dan tidak akan ditimpa lagi oleh deploy.sh.

# Resolver DNS embedded Docker. WAJIB dipakai bersama proxy_pass bervariabel
# (lihat `set $app_up ...` di bawah): blok `upstream {}` klasik hanya resolve
# nama SEKALI saat nginx start, jadi begitu container app di-recreate/scale,
# nginx tetap menembak IP lama sampai di-restart manual. Dengan resolver +
# variabel, nginx resolve ulang tiap `valid=10s` — scaling APP_REPLICAS
# terlihat otomatis dalam ≤10 detik tanpa reload.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 3s;

# Sembunyikan versi nginx dari header Server: dan halaman error bawaan —
# directive ini di-inherit ke semua server{}/location{} di bawah (beda dari
# add_header yang all-or-nothing per-location, lihat snippets/proxy-common.conf).
server_tokens off;

proxy_cache_path /var/cache/nginx/static levels=1:2 keys_zone=static_cache:10m
                 max_size=1g inactive=7d use_temp_path=off;

limit_req_zone $binary_remote_addr zone=apis:10m rate=40r/s;
# Batas koneksi konkuren per-IP — mitigasi dasar terhadap satu klien membuka
# terlalu banyak koneksi sekaligus (pelengkap limit_req yang membatasi laju).
limit_conn_zone $binary_remote_addr zone=perip:10m;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# ── Penyuntingan kredensial di access log ──────────────────────────────────
# Token ArcGIS milik PENGGUNA menempel sebagai query param pada URL ubin
# (OpenLayers: src.updateParams({ token }), lihat MultiMapContent.tsx di repo
# source), lalu URL itu lewat proxy peta kita. Dengan log_format bawaan
# ("combined" mencatat $request, yang memuat query string), token tersebut
# ikut tersimpan di access log — bisa dibaca siapa pun yang punya akses ke
# log server, padahal itu kredensial milik pengguna, bukan milik kita.
#
# Map di bawah menyunting query string HANYA kalau ia memuat parameter
# berbau kredensial. Request lain tetap tercatat lengkap, jadi nilai log
# untuk penelusuran masalah (page/sort/filter, dsb) tidak ikut hilang.
#
# Pencocokan sengaja pada KEHADIRAN kata (bukan "token=") — pada proxy peta,
# token kerap tertanam di dalam param `url=`/`target=` yang sudah ter-encode
# ("token%3D"), sehingga pola "token=" tidak akan menangkapnya. Lebih baik
# menyunting kelewat banyak daripada meloloskan kredensial.
map $request_uri $loggable_request_uri {
    default $request_uri;
    "~*^(?<req_path_only>[^?]*)\?.*(token|apikey|api_key|access_token|authkey|password|secret)" "${req_path_only}?[query disunting]";
}

log_format redacted '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $loggable_request_uri $server_protocol" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent"';



# ── :80 — ACME challenge + redirect ke HTTPS ────────────────────────────────
server {
    listen 80;
    listen [::]:80;

# access_log DITEMPATKAN DI DALAM server{} — BUKAN di level http. nginx hanya
# mewarisi access_log kalau level saat ini TIDAK mendefinisikannya sendiri;
# menaruhnya di http hanya MENAMBAH tujuan log, sehingga nginx.conf bawaan
# image (yang mencatat format "main" lengkap dgn query string) tetap ikut
# menulis dan token tetap bocor. Terbukti lewat uji nyata: token masih muncul
# 2x di log. Di sini ia MENIMPA warisan itu.
    access_log /var/log/nginx/access.log redacted;
    server_name __DOMAIN__;

    # Harus di atas redirect (^~ mengalahkan prefix match lain, termasuk location /).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── :443 — aplikasi ──────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;

# access_log DITEMPATKAN DI DALAM server{} — BUKAN di level http. nginx hanya
# mewarisi access_log kalau level saat ini TIDAK mendefinisikannya sendiri;
# menaruhnya di http hanya MENAMBAH tujuan log, sehingga nginx.conf bawaan
# image (yang mencatat format "main" lengkap dgn query string) tetap ikut
# menulis dan token tetap bocor. Terbukti lewat uji nyata: token masih muncul
# 2x di log. Di sini ia MENIMPA warisan itu.
    access_log /var/log/nginx/access.log redacted;
    http2 on;
    server_name __DOMAIN__;

    # Saat bootstrap TLS pertama kali, path ini berisi dummy self-signed cert
    # (dibuat deploy.sh supaya nginx bisa start sebelum certbot pernah jalan).
    # Setelah bootstrap_tls() sukses, file yang sama berisi cert Let's Encrypt asli.
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # OCSP stapling — server yang mengirim status revocation sertifikat
    # sendiri ke klien, klien tidak perlu query terpisah ke CA. chain.pem
    # dibuat deploy.sh (dummy saat bootstrap, diganti asli oleh certbot) —
    # sama seperti fullchain.pem/privkey.pem, supaya nginx tidak gagal start
    # sebelum sertifikat asli pernah diterbitkan.
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/__DOMAIN__/chain.pem;

    # Security header (HSTS, X-Frame-Options, dst.) ditaruh di
    # snippets/proxy-common.conf, BUKAN di sini — nginx tidak mewarisi
    # add_header ke location yang punya add_header sendiri (lihat komentar
    # di file snippet), jadi harus didefinisikan di tempat yang di-include
    # semua location, bukan di level server block ini.
    #
    # CSP sengaja TIDAK ditambahkan — butuh audit manual terhadap seluruh
    # script/style/worker source yang dipakai app ini (Cesium worker, dsb.)
    # sebelum aman diaktifkan; menambah CSP tanpa audit berisiko mematahkan
    # aplikasi.

    # Pelengkap limit_req (laju) — batasi jumlah koneksi konkuren per-IP.
    limit_conn perip 40;

    client_max_body_size 32m;
    gzip on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json text/css image/svg+xml application/xml;

    # Variabel (bukan host literal) — memaksa nginx resolve ulang lewat
    # `resolver` di atas, bukan cache sekali di startup.
    set $app_up http://app:3000;

    # Fixture data pengembangan yang PERNAH ikut terbit ke produksi lewat
    # public/ Next.js (yang disajikan di root web tanpa syarat) — isinya
    # memuat kontak PIC (nama/email/telepon) ratusan instansi, dan produksi
    # sendiri TIDAK PERNAH memakainya (DATA_SOURCE=backend). Terverifikasi
    # nyata terbuka publik & terunduh penuh sebelum ditutup.
    #
    # Sejak rilis yang memindahkannya ke data/ (di luar public/), file ini
    # sudah tidak ada lagi di image — blok ini jaring pengaman lapis kedua:
    # melindungi juga instalasi yang MASIH memakai image lama, dan menutup
    # kemungkinan file serupa tidak sengaja masuk public/ lagi. `= ` (exact
    # match) mengalahkan prefix `location /` di bawah.
    location = /sample-csw.json {
        return 404;
    }

    location /_next/static/ {
        proxy_pass $app_up$request_uri;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_cache static_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_lock on;
        add_header X-Nginx-Cache $upstream_cache_status always;
    }

    location /apis/ {
        limit_req zone=apis burst=80 nodelay;
        proxy_pass $app_up$request_uri;
        # proxy_read_timeout SUDAH ada di proxy-common.conf (60s) — jangan
        # ditulis ulang di sini, nginx menolak start kalau directive dobel.
        include /etc/nginx/snippets/proxy-common.conf;
    }

    location / {
        proxy_pass $app_up$request_uri;
        include /etc/nginx/snippets/proxy-common.conf;
    }
}

# Dashboard native GlitchTip (:8443) & Uptime Kuma (:8444) TIDAK LAGI
# diekspos di sini (dihapus 2026-08-11) — cuma port 80/443 yang dibuka ke
# luar sekarang (lihat README.md § Lockdown port). Ringkasan error/uptime
# tetap bisa dilihat lewat /admin/kesehatan-sistem di dashboard admin app
# (khusus role Superadmin), yang bicara ke GlitchTip/Uptime Kuma lewat API
# internal (GLITCHTIP_API_TOKEN/UPTIME_KUMA_METRICS_PASSWORD di harvester),
# bukan lagi lewat proxy nginx terpisah. Butuh akses UI native langsung utk
# debugging mendalam? Pakai SSH port-forward/`docker compose exec`, BUKAN
# expose permanen lewat nginx lagi — lihat README.md.
